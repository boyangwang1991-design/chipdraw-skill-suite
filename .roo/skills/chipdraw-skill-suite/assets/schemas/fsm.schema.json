{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chipdraw.aixsilicon.io/schemas/fsm.schema.json",
  "title": "RTL 行为模型（FSM / Timing / Sequence）",
  "description": "L3 RTL 行为级：状态机、数字时序（WaveDrom）、事务序列。一个 type 节点承载三小类，由 subtype 区分。",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/fsm" },
    { "$ref": "#/definitions/timing" },
    { "$ref": "#/definitions/sequence" }
  ],
  "definitions": {
    "trace": {
      "type": "object",
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "anchor": { "type": "string" },
              "symbol": { "type": "string" }
            }
          }
        },
        "confidence": { "type": "string", "enum": ["confirmed", "extracted", "inferred", "tbd"] },
        "owner": { "type": "string" },
        "review_status": { "type": "string" }
      }
    },
    "fsm": {
      "type": "object",
      "required": ["initial_state", "states", "transitions"],
      "properties": {
        "initial_state": { "type": "string" },
        "encoding": { "type": "string", "enum": ["one_hot", "binary", "gray", "unknown"] },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "category"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "category": { "type": "string", "enum": ["normal", "fault", "reset", "recovery", "error"] },
              "encoding_value": { "type": "string" },
              "trace": { "$ref": "#/definitions/trace" }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "condition": { "type": "string" },
              "action": { "type": "string" },
              "source": { "type": "string", "enum": ["rtl", "spec", "inferred"], "default": "inferred" },
              "trace": { "$ref": "#/definitions/trace" }
            }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["clock", "signals"],
      "properties": {
        "clock": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "period": { "type": "string", "description": "周期，如 10ns；可含数字与单位" },
            "phase": { "type": "number", "description": "相位偏移（周期比例，如 0.5）" },
            "wave": { "type": "string", "description": "可选：显式时钟 wave（如 p...../P.....）；缺省按信号长度自动生成 P/N 时钟" },
            "polarity": { "type": "string", "enum": ["positive", "negative"], "default": "positive" },
            "edge_marker": { "type": "boolean", "default": true, "description": "工作沿是否画边沿标记（P/N 而非 p/n）" },
            "display": { "type": "boolean", "default": true, "description": "是否把时钟作为单独 lane 显示；false 时仅作时间标尺（head.tick）" }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["name", "wave"],
                "properties": {
                  "name": { "type": "string" },
                  "wave": {
                    "description": "WaveDrom wave：字符串（如 0.1...0，含时钟字符 p/P/n/N）或 path 波形 ['pw',{d:...}]",
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {},
                        "description": "['pw', {d: 'SVG path 命令'}] 模拟/自定义波形"
                      }
                    ]
                  },
                  "data": {
                    "description": "数据值，对应每个引用字符（数字 2-9 与 =）；可为数组或空格分隔字符串",
                    "oneOf": [
                      { "type": "array", "items": { "type": "string" } },
                      { "type": "string" }
                    ]
                  },
                  "node": { "type": "string", "description": "WaveDrom node 字符串（箭头锚点），与 wave 同长" },
                  "over": { "type": "string", "description": "建立时间窗口 wave（over/under 注释区）" },
                  "under": { "type": "string", "description": "保持时间窗口 wave（over/under 注释区）" },
                  "period": { "type": "number", "description": "每信号周期乘数（如 DDR 的 2）" },
                  "phase": { "type": "number", "description": "每信号相位偏移" },
                  "required": { "type": "boolean", "default": false }
                }
              },
              {
                "type": "object",
                "maxProperties": 0,
                "description": "空 lane（spacer/分隔），WaveDrom 合法"
              },
              {
                "type": "array",
                "minItems": 2,
                "items": {},
                "description": "分组：['组名', {...信号...}, ['子组', ...]]，可嵌套；首元素为组名"
              }
            ]
          }
        },
        "groups": {
          "type": "array",
          "description": "可选：显式分组列表（信号用 group 字段引用）；也可直接用嵌套数组表达分组",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "signals": {
                "type": "array",
                "items": { "type": "string" },
                "description": "组内信号名（按顺序）"
              }
            }
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cycle", "text"],
            "properties": {
              "cycle": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": { "type": "string" },
          "description": "箭头边：'a->b label'、'a~b'、'a-|b' 等，引用信号 node 锚点"
        },
        "gaps": {
          "type": "string",
          "description": "Gap 表达式（WaveDrom）：如 '1.1s.1'、'(. |.. )'、'. s'；'. s'=spacer 尺寸、'1'=gap 位置"
        },
        "config": {
          "type": "object",
          "description": "渲染配置（WaveDrom config 属性）",
          "properties": {
            "hscale": { "type": "integer", "minimum": 1, "default": 1, "description": "水平缩放" },
            "skin": { "type": "string", "enum": ["default", "narrow"], "description": "皮肤" },
            "arcFontSize": { "type": "number", "description": "箭头弧线字体大小" }
          }
        },
        "head": {
          "type": "object",
          "description": "图上方区域：标题/时间标尺",
          "properties": {
            "text": { "type": "string", "description": "标题文本（纯文本）" },
            "tick": { "type": "integer", "description": "对齐标尺的起始刻度" },
            "tock": { "type": "integer" },
            "every": { "type": "integer", "description": "每隔 N 个周期画一个 tick/tock" }
          }
        },
        "foot": {
          "type": "object",
          "description": "图下方区域：说明/时间标尺",
          "properties": {
            "text": { "type": "string" },
            "tick": { "type": "integer" },
            "tock": { "type": "integer" }
          }
        },
        "protocol_rules": { "type": "string", "description": "如 APB setup/access 相位要求" },
        "origin": { "type": "string", "enum": ["spec", "simulation", "inferred"], "default": "inferred" }
      }
    },
    "sequence": {
      "type": "object",
      "required": ["participants", "messages"],
      "properties": {
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "actor": { "type": "boolean", "default": false }
            }
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "label"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" },
              "async": { "type": "boolean", "default": false },
              "return": { "type": "boolean", "default": false },
              "note": { "type": "string" },
              "over": { "type": "string" },
              "trace": { "$ref": "#/definitions/trace" }
            }
          }
        }
      }
    }
  }
}
